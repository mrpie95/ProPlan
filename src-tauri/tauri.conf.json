{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProPlan",
  "version": "0.3.0",
  "identifier": "com.michaelpieniazek.proplan",
  "build": {
    "beforeDevCommand": "node scripts/tauri-prepare.mjs",
    "beforeBuildCommand": "node scripts/tauri-prepare.mjs",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
