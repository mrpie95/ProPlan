{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProPlan",
  "version": "0.1.0",
  "identifier": "com.michaelpieniazek.proplan",
  "build": {
    "beforeDevCommand": "node scripts/tauri-prepare.mjs",
    "beforeBuildCommand": "node scripts/tauri-prepare.mjs",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ProPlan",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
