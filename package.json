{
  "name": "proplan",
  "version": "0.3.0",
  "private": true,
  "description": "Single-file Gantt/phase planner. The app is ProPlan.html; this package.json hosts the test runner + build/inline script.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "node scripts/build.mjs && tauri build && node scripts/links.mjs",
    "link": "node scripts/links.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitest/coverage-v8": "^1.6.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  }
}
